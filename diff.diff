+//uniform mat3 normalMatrix;     //!< ユニフォーム: モデルの法線用行列
+//uniform mat4 modelViewMatrix;  //!< ユニフォーム: プロジェクション行列
+//uniform mat4 projectionMatrix; //!< ユニフォーム: モデル行列
+// All provided by three.js ^^
