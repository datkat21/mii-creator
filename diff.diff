+export async function getShaderMaterialFromShaderType() {
+  const shaderType = (await getSetting("shaderType")) as ShaderType;
+  switch (shaderType) {
+    case ShaderType.WiiU:
+    case ShaderType.LightDisabled:
+    case ShaderType.WiiUBlinn:
