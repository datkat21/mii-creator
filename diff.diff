+		// THREE.RGFormat did not work for me on Three.js r136/older.
+		const useGLES2Formats = Number(THREE.REVISION) < 137;
+		const r8 = useGLES2Formats
+			? THREE.LuminanceFormat
+			: THREE.RedFormat;
+		const r8g8 = useGLES2Formats
