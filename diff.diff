+// フラグメントシェーダーへの入力
+varying   vec4 v_color;          //!< 出力: 頂点の色
+varying   vec4 v_position;       //!< 出力: 位置情報
+varying   vec3 v_normal;         //!< 出力: 法線ベクトル
+varying   vec3 v_tangent;        //!< 出力: 異方位
+varying   vec2 v_texCoord;       //!< 出力: テクスチャー座標
