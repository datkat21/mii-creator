+    case ShaderType.WiiUToon:
+    case ShaderType.Switch:
+      // todo: switch should have its own material class?
+      return FFLShaderMaterial;
+    case ShaderType.Miitomo:
+      return LUTShaderMaterial;
+  }
+}
