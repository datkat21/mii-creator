+// ─────────────────────────────────────────────────────────
+// Fragment Shader for FFLShaderMaterial
+// Mostly unmodified from MiiDefaultShader.fsh found in Miitomo.
+// ─────────────────────────────────────────────────────────
+const _FFLShader_frag = /* glsl */ `
+//
+//  sample.flg
+//  Fragment shader
+//  Copyright (c) 2014 Nintendo Co., Ltd. All rights reserved.
